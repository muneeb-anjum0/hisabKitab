<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_paper" android:padding="13dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HK!  QUICK LEDGER" android:textColor="#12110F" android:textStyle="bold" android:textSize="19sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="DON'T LET A RUPEE ESCAPE." android:textColor="#55514A" android:textStyle="bold" android:textSize="9sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_marginStart="10dp">
        <TextView android:id="@+id/widget_expense" android:layout_width="120dp" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/widget_red" android:text="＋ EXPENSE" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:id="@+id/widget_money" android:layout_width="120dp" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:background="@drawable/widget_yellow" android:text="＋ MONEY IN" android:textColor="#12110F" android:textStyle="bold" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
